rules_version = '2';

// Roles:
//   Super admin (you): Firebase Auth custom claim { admin: true },
//     set by scripts/set-claims.mjs — this stays admin-only and rare.
//   Business staff: NOT a custom claim anymore. It's just the business
//     document's own `staffUids` array. Any signed-in user can create a
//     business with themselves in staffUids[0] — that's what makes signup
//     self-service with no action needed from you. Legacy businesses set up
//     via the old `staffOf` token claim still work too (checked below).
//
// Customers never sign in. Every rule that lets an unauthenticated visitor
// read or write is deliberate and scoped as tightly as rules allow.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function bizStaffUids(businessId) {
      let biz = get(/databases/$(database)/documents/businesses/$(businessId)).data;
      return ('staffUids' in biz) ? biz.staffUids : [];
    }

    function isStaffOf(businessId) {
      return request.auth != null && (
        (request.auth.token.staffOf != null && businessId in request.auth.token.staffOf) ||
        request.auth.uid in bizStaffUids(businessId)
      );
    }

    match /businesses/{businessId} {
      // Public read so the ticket page can resolve a slug with no login.
      allow read: if true;
      // Self-service signup: any signed-in user can create a business with
      // themselves as its one and only initial staff member. You (admin)
      // can also create one directly from /super-admin, with or without that.
      allow create: if isAdmin() || (
        request.auth != null &&
        request.resource.data.staffUids is list &&
        request.resource.data.staffUids.size() == 1 &&
        request.resource.data.staffUids[0] == request.auth.uid
      );
      allow update: if isAdmin() || isStaffOf(businessId);
      allow delete: if isAdmin();

      match /queues/{queueId} {
        allow read: if true;
        allow create, delete: if isAdmin() || isStaffOf(businessId);
        allow update: if isAdmin() || isStaffOf(businessId) ||
          // An anonymous customer's createTicket() transaction is allowed to
          // bump nextNumber (by 1, or reset to 2 on a new day's first
          // ticket) and update lastResetDate, only while not cut off.
          (
            resource.data.cutoff == false &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextNumber', 'lastResetDate']) &&
            (
              request.resource.data.nextNumber == resource.data.nextNumber + 1 ||
              request.resource.data.nextNumber == 2
            )
          );
      }

      match /stations/{stationId} {
        allow read: if true;
        allow write: if isAdmin() || isStaffOf(businessId);
      }

      match /tickets/{ticketId} {
        allow read: if true;
        allow create: if request.resource.data.status == 'waiting' &&
          !('stationId' in request.resource.data);
        allow update, delete: if isAdmin() || isStaffOf(businessId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
